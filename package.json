    "i18next-browser-languagedetector": "^8.0.0",
    "js-yaml": "^4.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^15.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.1.2",
    "typescript": "^5.9.3",
