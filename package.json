{
  "name": "gemini-bot-flow-studio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "cd server && npm run dev",
    "gateway": "cd twitch-gateway && npm run dev",
    "dev:full": "concurrently -k -p \"[{name}]\" -n \"FRONTEND,BACKEND,GATEWAY\" -c \"cyan.bold,blue.bold,magenta.bold\" \"npm run dev\" \"npm run server\" \"npm run gateway\"",
    "build:docker": "node scripts/build-container.js docker",
    "build:podman": "node scripts/build-container.js podman"
  },
